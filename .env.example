# Gemini API
GEMINI_API_KEY=
# Optional model override. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# TEMPORARY TESTING FLAG — do not set in production.
# Default (unset or any value other than the exact string "false") keeps the
# owner/admin AAL2 (multi-factor) requirement enforced. Set exactly to "false"
# ONLY to test privileged flows while MFA enrollment is being fixed; it skips
# the AAL2 check and nothing else (auth, role, org isolation, governance,
# rate limits, budgets, audit all still apply).
# ARBYTER_REQUIRE_MFA=false
